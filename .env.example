# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PostgreSQL (Supabase)
PG_CONNECTION_URI=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres

# Cron Job Secret
CRON_SECRET=your_cron_secret_here

# Web Push (browser reminders). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:noreply@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
